#| --------------------------------------------------------------------------
Macbook pro 16" Nordic layout
(deflayer name
  _      _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _    _
  _       _    _    _    _    _    _    _    _    _    _    _    _
  _     _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _               _              _     _         _
                                                           _    _    _
)
  -------------------------------------------------------------------------- |#
(defcfg
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
  process-unmapped-keys yes
  ;; Requires kanata >= 1.12.0.
  ;; A tap-hold key pressed within 150 ms of another key resolves as tap
  ;; immediately (typing-streak protection). Lower if you type faster.
  tap-hold-require-prior-idle 150
)

;; Physical hand assignment for tap-hold-opposite-hand-release (kanata >= 1.12.0).
;; Thumb keys are included so e.g. right-Cmd (j) + Enter thumb fires instantly.
(defhands
  (left  nubs ` 1 2 3 4 5 tab q w e r t caps a s d f g z x c v b lalt lmet)
  (right 6 7 8 9 0 - = bspc y u i o p [ ] ret h j k l ; ' \ n m , . / rmet ralt)
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  nubs  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]    ret
  caps    a    s    d    f    g    h    j    k    l    ;    '    \
  lsft  `   z    x    c    v    b    n    m    ,    .    /    rsft
  fn   lctl lalt lmet           spc            rmet ralt          up
                                                            left down rght
)

(deflayer main
  esc   brdn  brup  A-tab  M-spc   bldn  blup   prev  pp  next  mute  voldwn  volu
  caps  _    _    _    _    _    _    _    _    _    _    XX    XX    XX
  _      _    _    _    _    _    _    _    _    _    _    XX    XX    XX
  esc     @s_a  @a_s   @c_d   @m_f    _    _  @m_j  @c_k  @a_l  @s_;    _    _
  XX    fn    _    _    _    _    _    _    _    _    _    _    _
  @fn  XX    @nav    @ret               _              bspc     del          _
                                                            _    _    _
)

(deflayer num
  _      _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  S-7      S-1    S-2    S-3    S-4    S-5    S-8    7    8    9   S-9   S-0    _    _
  \    lsft  lalt lctl  lmet   =    -    4    5    6    S-[   S-]    _
  _    fn    `    S-`   S--    S-6    S-\    +    1    2    3    [    ]
  _    _    _    _               _              0     _         _
                                                           _    _    _
)

(deflayer nav
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    lsft lalt lctl lmet    _    left    down    up    right    _    _    _
  _   _   _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _                _                _    _        _
                                                            _    _    _
)

(defvar
  tap-timeout   300
  hold-timeout  200
  tt $tap-timeout
  ht $hold-timeout
)

(defalias 
    ;; For layer switching
    off (layer-switch off_layer)
    trans (layer-switch transpartent)
    eng (layer-switch main)

    ;; For layer toggling
    fn (layer-while-held function_layer)
    nav (layer-while-held nav)
    ;; require-prior-idle 0: number layer must work right after typing letters
    ret (tap-hold-release $tt $ht ret (layer-while-held num) (require-prior-idle 0))
)

(defalias
    ;; Home Row Mods (kanata >= 1.12.0)
    ;; - opposite-hand key pressed+released  -> modifier (as before)
    ;; - same-hand key                       -> ignored until $ht timeout, then modifier
    ;;                                          (so same-hand rolls stay letters; same-hand
    ;;                                          shortcuts like f+c = Cmd+C need a 200 ms hold)
    ;; - released before timeout             -> letter
    ;; - tap-repress-timeout keeps tap-then-hold key repeat from the old first argument
    s_a (tap-hold-opposite-hand-release $ht a lsft (timeout hold) (same-hand ignore) (tap-repress-timeout $tt))
    a_s (tap-hold-opposite-hand-release $ht s lalt (timeout hold) (same-hand ignore) (tap-repress-timeout $tt))
    c_d (tap-hold-opposite-hand-release $ht d lctl (timeout hold) (same-hand ignore) (tap-repress-timeout $tt))
    m_f (tap-hold-opposite-hand-release $ht f lmet (timeout hold) (same-hand ignore) (tap-repress-timeout $tt))

    m_j (tap-hold-opposite-hand-release $ht j rmet (timeout hold) (same-hand ignore) (tap-repress-timeout $tt))
    c_k (tap-hold-opposite-hand-release $ht k rctl (timeout hold) (same-hand ignore) (tap-repress-timeout $tt))
    a_l (tap-hold-opposite-hand-release $ht l ralt (timeout hold) (same-hand ignore) (tap-repress-timeout $tt))
    s_; (tap-hold-opposite-hand-release $ht ; rsft (timeout hold) (same-hand ignore) (tap-repress-timeout $tt))
)

(deflayer transpartent
  caps      _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _    _
  esc       _    _    _    _    _    _    _    _    _    _    _    _
  _     _    _    _    _    _    _    _    _    _    _    _    _
  @fn  _    _    _               _              _     _         _
                                                           _    _    _
)

(deflayer function_layer
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _   _    _    _    _    _    _    _    @off
  _    _    _    _    @trans    _    _  @eng    _    _    _    _    _
  _   _   _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _              _              _    _          _
                                                          _    _    _
)

(deflayer off_layer
  XX      XX    XX    XX    XX    @eng  XX    XX    XX    XX    XX    XX    XX
  XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX
  XX      XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX
  XX       XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX
  XX     XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX
  XX    XX    XX    XX               XX              XX     XX         XX
                                                           XX    XX    XX
)
